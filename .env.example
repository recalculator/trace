# Trace - example environment. Copy to .env and fill in, or export directly.
#
#   cp .env.example .env && $EDITOR .env && source .env
#
# .env is gitignored; this file is the committed template and must never
# contain a real key. Trace reads ANTHROPIC_API_KEY from the environment and
# from nowhere else - no file, no argument, no config entry.
#
# Without it, everything still works: the deterministic planner runs and the
# explanation is generated from evidence alone.
export ANTHROPIC_API_KEY=sk-ant-your-key-here
